// Stand-in for <optional>.
#ifndef STUB_OPTIONAL
#define STUB_OPTIONAL
#include <new>
#include <utility>
namespace std {
struct nullopt_t { explicit constexpr nullopt_t(int) {} };
inline constexpr nullopt_t nullopt{0};
template<typename T> class optional {
	bool has = false;
	alignas(T) unsigned char buf[sizeof(T)];
public:
	constexpr optional(nullopt_t) noexcept {}
	optional(const optional& o) : has(o.has) { if (has) new (buf) T(*o); }
	explicit operator bool() const noexcept { return has; }
	const T& operator*() const noexcept { return *reinterpret_cast<const T*>(buf); }
	T& operator*() noexcept { return *reinterpret_cast<T*>(buf); }
};
}
#endif
