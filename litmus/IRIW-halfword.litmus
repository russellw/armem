AArch64 IRIW-halfword
"Single halfword reads cannot see two byte writes in opposite orders"
{ uint16_t x; 0:X1=x; 1:X1=x; 2:X1=x; 3:X1=x; }
 P0           | P1           | P2           | P3           ;
 MOV W0,#1    | LDRH W0,[X1] | MOV W0,#1    | LDRH W0,[X1] ;
 STRB W0,[X1] |              | ADD X2,X1,#1 |              ;
              |              | STRB W0,[X2] |              ;
exists (1:X0=1 /\ 3:X0=256)
