AArch64 IRIW+addrs
"ARMv8 is other-multi-copy-atomic: forbidden"
{ 0:X1=x; 1:X1=x; 1:X3=y; 2:X1=y; 3:X1=y; 3:X3=x; }
 P0          | P1                  | P2          | P3                  ;
 MOV W0,#1   | LDR W0,[X1]         | MOV W0,#1   | LDR W0,[X1]         ;
 STR W0,[X1] | EOR W4,W0,W0        | STR W0,[X1] | EOR W4,W0,W0        ;
             | LDR W2,[X3,W4,SXTW] |             | LDR W2,[X3,W4,SXTW] ;
exists (1:X0=1 /\ 1:X2=0 /\ 3:X0=1 /\ 3:X2=0)
