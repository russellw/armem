AArch64 MP+swpal-private+dmb
"P0's SWPAL to a private location orders its two stores"
{ 0:X1=x; 0:X3=y; 0:X5=p; 1:X1=y; 1:X3=x; }
 P0                | P1          ;
 MOV W0,#1         | LDR W0,[X1] ;
 STR W0,[X1]       | DMB SY      ;
 SWPAL W0,W4,[X5]  | LDR W2,[X3] ;
 STR W0,[X3]       |             ;
exists (1:X0=1 /\ 1:X2=0)
