// Stand-in for <atomic>: what atomic_queue uses, on clang's __atomic
// builtins, for integral and pointer T.
#ifndef STUB_ATOMIC
#define STUB_ATOMIC
namespace std {
enum memory_order {
	memory_order_relaxed = __ATOMIC_RELAXED,
	memory_order_consume = __ATOMIC_CONSUME,
	memory_order_acquire = __ATOMIC_ACQUIRE,
	memory_order_release = __ATOMIC_RELEASE,
	memory_order_acq_rel = __ATOMIC_ACQ_REL,
	memory_order_seq_cst = __ATOMIC_SEQ_CST,
};
// The failure order that a compare-exchange with one order uses.
constexpr memory_order failure_order(memory_order m) noexcept {
	return m == memory_order_acq_rel ? memory_order_acquire : m == memory_order_release ? memory_order_relaxed : m;
}
template<typename T> struct atomic {
	static constexpr bool is_always_lock_free = __atomic_always_lock_free(sizeof(T), 0);
	alignas(sizeof(T)) T v;
	atomic() noexcept = default;
	constexpr atomic(T x) noexcept : v(x) {}
	atomic(const atomic&) = delete;
	atomic& operator=(const atomic&) = delete;
	bool is_lock_free() const noexcept { return __atomic_is_lock_free(sizeof(T), &v); }
	T load(memory_order m = memory_order_seq_cst) const noexcept { return __atomic_load_n(&v, m); }
	operator T() const noexcept { return load(); }
	void store(T x, memory_order m = memory_order_seq_cst) noexcept { __atomic_store_n(&v, x, m); }
	T exchange(T x, memory_order m = memory_order_seq_cst) noexcept { return __atomic_exchange_n(&v, x, m); }
	bool compare_exchange_strong(T& e, T x, memory_order s, memory_order f) noexcept {
		return __atomic_compare_exchange_n(&v, &e, x, false, s, f);
	}
	bool compare_exchange_strong(T& e, T x, memory_order m = memory_order_seq_cst) noexcept {
		return compare_exchange_strong(e, x, m, failure_order(m));
	}
	bool compare_exchange_weak(T& e, T x, memory_order s, memory_order f) noexcept {
		return __atomic_compare_exchange_n(&v, &e, x, true, s, f);
	}
	bool compare_exchange_weak(T& e, T x, memory_order m = memory_order_seq_cst) noexcept {
		return compare_exchange_weak(e, x, m, failure_order(m));
	}
	T fetch_add(T x, memory_order m = memory_order_seq_cst) noexcept { return __atomic_fetch_add(&v, x, m); }
};
}
#endif
