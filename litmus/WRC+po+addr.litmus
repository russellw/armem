AArch64 WRC+po+addr
{ 0:X1=x; 1:X1=x; 1:X3=y; 2:X1=y; 2:X3=x; }
 P0          | P1          | P2                  ;
 MOV W0,#1   | LDR W0,[X1] | LDR W0,[X1]         ;
 STR W0,[X1] | MOV W2,#1   | EOR W4,W0,W0        ;
             | STR W2,[X3] | LDR W2,[X3,W4,SXTW] ;
exists (1:X0=1 /\ 2:X0=1 /\ 2:X2=0)
