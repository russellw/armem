AArch64 LDXP-STXP-read
"Fixed: an LDXP confirmed by a successful STXP of the same values is atomic"
{ 0:X1=x; 1:X1=x; }
 P0                  | P1                  ;
 MOV X2,#1           | L1:                 ;
 MOV X3,#1           | LDXP X2,X3,[X1]     ;
 L0:                 | STXP W4,X2,X3,[X1]  ;
 LDXP X5,X6,[X1]     | CBNZ W4,L1          ;
 STXP W4,X2,X3,[X1]  |                     ;
 CBNZ W4,L0          |                     ;
exists (1:X2=1 /\ 1:X3=0 \/ 1:X2=0 /\ 1:X3=1)
