AArch64 MP-split-read
"Two word reads of one doubleword write may see different versions"
{ uint64_t x; 0:X1=x; 1:X1=x; }
 P0          | P1            ;
 MOV X0,#1   | LDR W0,[X1]   ;
 LSL X2,X0,#32 | LDR W2,[X1,#4];
 ORR X0,X0,X2 |              ;
 STR X0,[X1] |               ;
exists (1:X0=1 /\ 1:X2=0)
