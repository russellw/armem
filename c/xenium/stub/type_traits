// Stand-in for <type_traits>: what the kfifo queue, the hash map and
// their headers use.
#ifndef STUB_TYPE_TRAITS
#define STUB_TYPE_TRAITS
#include <cstddef>
namespace std {
template<typename T, T v> struct integral_constant {
	static constexpr T value = v;
	typedef T value_type;
	typedef integral_constant type;
	constexpr operator T() const noexcept { return v; }
};
typedef integral_constant<bool, true> true_type;
typedef integral_constant<bool, false> false_type;
template<bool B, typename T, typename F> struct conditional { typedef T type; };
template<typename T, typename F> struct conditional<false, T, F> { typedef F type; };
template<bool B, typename T, typename F> using conditional_t = typename conditional<B, T, F>::type;
template<typename T> struct remove_reference { typedef T type; };
template<typename T> struct remove_reference<T&> { typedef T type; };
template<typename T> struct remove_reference<T&&> { typedef T type; };
template<typename T> struct remove_pointer { typedef T type; };
template<typename T> struct remove_pointer<T*> { typedef T type; };
template<typename T> using remove_pointer_t = typename remove_pointer<T>::type;
template<typename T> struct is_pointer : false_type {};
template<typename T> struct is_pointer<T*> : true_type {};
template<typename T> struct is_trivially_copyable : integral_constant<bool, __is_trivially_copyable(T)> {};
template<typename T> struct is_empty : integral_constant<bool, __is_empty(T)> {};
template<typename T> struct is_trivial : integral_constant<bool, __is_trivial(T)> {};
template<typename B, typename D> struct is_base_of : integral_constant<bool, __is_base_of(B, D)> {};
template<typename T> struct alignment_of : integral_constant<size_t, alignof(T)> {};
template<typename T> struct is_reference : false_type {};
template<typename T> struct is_reference<T&> : true_type {};
template<typename T> struct is_reference<T&&> : true_type {};
template<typename T> struct is_default_constructible : integral_constant<bool, __is_constructible(T)> {};
}
#endif
