AArch64 MP+rel+cas-addr
"A successful CAS's result may depend on the read only via the comparison"
{ 0:X1=x; 0:X3=y; 1:X1=y; 1:X3=x; }
 P0           | P1                  ;
 MOV W0,#1    | MOV W0,#1           ;
 STR W0,[X1]  | CAS W0,WZR,[X1]     ;
 MOV W2,#1    | EOR W4,W0,W0        ;
 STLR W2,[X3] | LDR W2,[X3,W4,SXTW] ;
exists (y=0 /\ 1:X2=0)
