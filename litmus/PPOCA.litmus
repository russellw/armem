AArch64 PPOCA
"Forwarding from a store after a control dependency: allowed on ARMv8"
{ 0:X1=x; 0:X3=y; 1:X1=y; 1:X3=z; 1:X6=x; }
 P0          | P1                  ;
 MOV W0,#1   | LDR W0,[X1]         ;
 STR W0,[X1] | CBNZ W0,LC00        ;
 DMB SY      | LC00:               ;
 MOV W2,#1   | MOV W2,#1           ;
 STR W2,[X3] | STR W2,[X3]         ;
             | LDR W4,[X3]         ;
             | EOR W5,W4,W4        ;
             | LDR W7,[X6,W5,SXTW] ;
exists (1:X0=1 /\ 1:X4=1 /\ 1:X7=0)
