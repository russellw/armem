AArch64 LDXP-STXP-read
"Fixed: an LDXP confirmed by a successful STXP of the same values is atomic"
{ uint64_t x[2]; 0:X1=x; 1:X1=x; }
 P0                  | P1                  ;
 MOV X2,#1           | LDXP X2,X3,[X1]     ;
 MOV X3,#1           | STXP W4,X2,X3,[X1]  ;
 LDXP X5,X6,[X1]     |                     ;
 STXP W4,X2,X3,[X1]  |                     ;
exists (0:X4=0 /\ 1:X4=0 /\ (1:X2=1 /\ 1:X3=0 \/ 1:X2=0 /\ 1:X3=1))
