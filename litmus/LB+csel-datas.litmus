AArch64 LB+csel-datas
"A CSEL (pick) dependency does order a later write"
{ 0:X1=x; 0:X3=y; 1:X1=y; 1:X3=x; }
 P0                | P1                ;
 LDR W0,[X1]       | LDR W0,[X1]       ;
 CMP W0,#1         | CMP W0,#1         ;
 MOV W5,#1         | MOV W5,#1         ;
 CSEL W2,W5,W5,EQ  | CSEL W2,W5,W5,EQ  ;
 STR W2,[X3]       | STR W2,[X3]       ;
exists (0:X0=1 /\ 1:X0=1)
