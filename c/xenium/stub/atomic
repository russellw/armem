// Stand-in for <atomic>: what the kfifo queue and the hash map use, on
// clang's __atomic builtins, as libstdc++'s is. The generic builtins take any trivially
// copyable type of 1, 2, 4 or 8 bytes, such as xenium's marked_ptr.
#ifndef STUB_ATOMIC
#define STUB_ATOMIC
namespace std {
enum memory_order {
	memory_order_relaxed = __ATOMIC_RELAXED,
	memory_order_consume = __ATOMIC_CONSUME,
	memory_order_acquire = __ATOMIC_ACQUIRE,
	memory_order_release = __ATOMIC_RELEASE,
	memory_order_acq_rel = __ATOMIC_ACQ_REL,
	memory_order_seq_cst = __ATOMIC_SEQ_CST,
};
// The failure order of a compare-and-swap given one order, as in libstdc++.
constexpr memory_order cas_failure_order(memory_order m) noexcept {
	return m == memory_order_acq_rel ? memory_order_acquire
		: m == memory_order_release ? memory_order_relaxed : m;
}
inline void atomic_thread_fence(memory_order m) noexcept { __atomic_thread_fence(m); }
template<typename T> struct atomic {
	alignas(sizeof(T)) T v;
	atomic() noexcept = default;
	constexpr atomic(T x) noexcept : v(x) {}
	atomic(const atomic&) = delete;
	atomic& operator=(const atomic&) = delete;
	T load(memory_order m = memory_order_seq_cst) const noexcept {
		alignas(sizeof(T)) unsigned char r[sizeof(T)];
		__atomic_load(&v, reinterpret_cast<T*>(r), m);
		return *reinterpret_cast<T*>(r);
	}
	void store(T x, memory_order m = memory_order_seq_cst) noexcept { __atomic_store(&v, &x, m); }
	operator T() const noexcept { return load(); }
	T operator=(T x) noexcept { store(x); return x; }
	T exchange(T x, memory_order m = memory_order_seq_cst) noexcept {
		alignas(sizeof(T)) unsigned char r[sizeof(T)];
		__atomic_exchange(&v, &x, reinterpret_cast<T*>(r), m);
		return *reinterpret_cast<T*>(r);
	}
	bool compare_exchange_strong(T& e, T x, memory_order s, memory_order f) noexcept {
		return __atomic_compare_exchange(&v, &e, &x, false, s, f);
	}
	bool compare_exchange_weak(T& e, T x, memory_order s, memory_order f) noexcept {
		return __atomic_compare_exchange(&v, &e, &x, true, s, f);
	}
	bool compare_exchange_strong(T& e, T x, memory_order m = memory_order_seq_cst) noexcept {
		return compare_exchange_strong(e, x, m, cas_failure_order(m));
	}
	bool compare_exchange_weak(T& e, T x, memory_order m = memory_order_seq_cst) noexcept {
		return compare_exchange_weak(e, x, m, cas_failure_order(m));
	}
};
}
#endif
