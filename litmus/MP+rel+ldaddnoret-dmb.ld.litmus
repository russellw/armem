AArch64 MP+rel+ldaddnoret-dmb.ld
"DMB LD does not order an atomic whose result goes to WZR"
{ 0:X1=x; 0:X3=y; 1:X1=y; 1:X3=x; }
 P0           | P1                 ;
 MOV W0,#1    | MOV W5,#1          ;
 STR W0,[X1]  | LDADD W5,WZR,[X1]  ;
 MOV W2,#1    | DMB LD             ;
 STLR W2,[X3] | LDR W2,[X3]        ;
exists (y=2 /\ 1:X2=0)
