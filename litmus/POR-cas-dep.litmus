AArch64 POR-cas-dep
"A successful CAS's result may depend on its read of x rather than on the expected value"
{ 0:X3=y; 0:X4=z; 1:X1=x; 2:X1=x; 2:X3=y; 2:X4=z; }
 P0          | P1          | P2                  ;
 MOV W0,#1   | MOV W0,#1   | LDR W0,[X4]         ;
 STR W0,[X3] | STR W0,[X1] | CBZ W0,L0           ;
 DMB ST      |             | MOV W5,#2           ;
 STR W0,[X4] |             | CAS W0,W5,[X1]      ;
             |             | EOR W6,W0,W0        ;
             |             | LDR W2,[X3,W6,SXTW] ;
             |             | L0:                 ;
exists (2:X0=1 /\ x=2 /\ 2:X2=0)
