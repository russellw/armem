AArch64 MP+dmb.sy+adc-addr
"ADC reads the carry flag, a data dependency (unlike CSEL's pick dependency), so it orders a later read"
{ 0:X1=x; 0:X3=y; 1:X1=y; 1:X3=x; }
 P0          | P1                  ;
 MOV W0,#1   | LDR W0,[X1]         ;
 STR W0,[X1] | CMP W0,#1           ;
 DMB SY      | ADC W4,WZR,WZR      ;
 MOV W2,#1   | EOR W4,W4,W4        ;
 STR W2,[X3] | LDR W2,[X3,W4,SXTW] ;
exists (1:X0=1 /\ 1:X2=0)
