// Stand-in for <memory>: the names pointer_queue_traits.hpp uses in its
// std::unique_ptr specialization, which the test never instantiates.
#ifndef STUB_MEMORY
#define STUB_MEMORY
#include <new>
namespace std {
template<typename T> struct default_delete { void operator()(T* p) const noexcept { delete p; } };
template<typename T, typename D = default_delete<T>> class unique_ptr;
struct ignore_t { template<typename T> const ignore_t& operator=(const T&) const noexcept { return *this; } };
inline constexpr ignore_t ignore{};
}
#endif
