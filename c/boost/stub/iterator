// Stand-in for <iterator>: distance and next, for pointers.
#ifndef STUB_ITERATOR
#define STUB_ITERATOR
#include <cstddef>
namespace std {
template<typename T> constexpr ptrdiff_t distance(T* first, T* last) { return last - first; }
template<typename T> constexpr T* next(T* p, ptrdiff_t n = 1) { return p + n; }
}
#endif
