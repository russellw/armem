AArch64 LDXP-STXP-counter
"128-bit atomic increment of both halves: if both STXPs succeed, no update is lost"
{ uint64_t x[2]; 0:X1=x; 1:X1=x; }
 P0                  | P1                  ;
 LDXP X2,X3,[X1]     | LDXP X2,X3,[X1]     ;
 ADD X2,X2,#1        | ADD X2,X2,#1        ;
 ADD X3,X3,#1        | ADD X3,X3,#1        ;
 STXP W4,X2,X3,[X1]  | STXP W4,X2,X3,[X1]  ;
exists (0:X4=0 /\ 1:X4=0 /\ ~(x[0]=2 /\ x[1]=2))
