AArch64 LDXP-torn
"Bug: an X-pair LDXP alone is not a 128-bit atomic read"
{ uint64_t x[2]; 0:X1=x; 1:X1=x; }
 P0                  | P1              ;
 MOV X2,#1           | LDXP X2,X3,[X1] ;
 MOV X3,#1           |                 ;
 LDXP X5,X6,[X1]     |                 ;
 STXP W4,X2,X3,[X1]  |                 ;
exists (0:X4=0 /\ (1:X2=1 /\ 1:X3=0 \/ 1:X2=0 /\ 1:X3=1))
