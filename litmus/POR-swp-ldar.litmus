AArch64 POR-swp-ldar
"An acquire read of the thread's own SWP write is ordered after the SWP's read of x"
{ 0:X3=y; 1:X1=x; 2:X1=x; 2:X3=y; }
 P0          | P1          | P2               ;
 MOV W0,#1   | MOV W0,#1   | MOV W5,#2        ;
 STR W0,[X3] | STR W0,[X1] | SWP W5,W6,[X1]   ;
             |             | LDAR W7,[X1]     ;
             |             | LDR W2,[X3]      ;
exists (2:X6=1 /\ 2:X2=0)
