// Stand-in for <utility>.
#ifndef STUB_UTILITY
#define STUB_UTILITY
#include <type_traits>
namespace std {
template<typename T> constexpr typename remove_reference<T>::type&& move(T&& t) noexcept {
	return static_cast<typename remove_reference<T>::type&&>(t);
}
template<typename T> constexpr T&& forward(typename remove_reference<T>::type& t) noexcept { return static_cast<T&&>(t); }
template<typename T> constexpr T&& forward(typename remove_reference<T>::type&& t) noexcept { return static_cast<T&&>(t); }
template<typename T> void swap(T& a, T& b) noexcept { T t = move(a); a = move(b); b = move(t); }
}
#endif
