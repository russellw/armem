AArch64 LB+rev-extr-datas
"Data dependencies through REV and EXTR order a later write"
{ 0:X1=x; 0:X3=y; 1:X1=y; 1:X3=x; }
 P0                  | P1                  ;
 LDR W0,[X1]         | LDR W0,[X1]         ;
 REV W2,W0           | RBIT X2,X0          ;
 EXTR W4,W2,W2,#24   | EXTR X4,X2,X2,#63   ;
 STR W4,[X3]         | STR W4,[X3]         ;
exists (0:X0=1 /\ 1:X0=1)
