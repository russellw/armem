AArch64 POR-pick-isb
"A pick dependency and ISB order P2's read of y after its read of x, so x must precede y"
{ 0:X3=y; 1:X1=x; 2:X1=x; 2:X3=y; }
 P0          | P1          | P2                  ;
 MOV W0,#1   | MOV W0,#1   | LDR W0,[X1]         ;
 STR W0,[X3] | STR W0,[X1] | CMP W0,#1           ;
             |             | CSEL W4,WZR,WZR,EQ  ;
             |             | CBNZ W4,L0          ;
             |             | L0:                 ;
             |             | ISB                 ;
             |             | LDR W2,[X3]         ;
exists (2:X0=1 /\ 2:X2=0)
