AArch64 MP+dmb.sy+addr-call
"Message passing; the reader's address dependency passes through a call's return value in X0"
{ 0:X1=x; 0:X3=y; 1:X1=y; 1:X3=x; }
 P0          | P1                    ;
 MOV W0,#1   | BL load_flag          ;
 STR W0,[X1] | r0:                   ;
 DMB SY      | EOR W4,W0,W0          ;
 MOV W2,#1   | LDR W2,[X3,W4,SXTW]   ;
 STR W2,[X3] | B end                 ;
             | load_flag:            ;
             | LDR W0,[X1]           ;
             | RET                   ;
             | end:                  ;
exists (1:X0=1 /\ 1:X2=0)
